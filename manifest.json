{
  "manifest_version": 3,
  "name": "Nera - AI Infiltration Agent",
  "version": "1.1.0",
  "description": "Auto-analysis and AI-driven commenting via DOM infiltration.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.linkedin.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": ["src/content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/pages/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Nera Control",
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon.png",
        "src/ui/pages/sidepanel/sidepanel.html",
        "src/ui/pages/sidepanel/sidepanel.js",
        "src/ui/pages/sidepanel/sidepanel.css",
        "src/content/modules/*.js",
        "src/ui/SidePanelManager.js",
        "src/ui/components/NeraSelect.js",
        "src/core/AIHub.js",
        "src/core/StorageManager.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

